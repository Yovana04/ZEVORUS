# ── Seguridad ─────────────────────────────────────────────
# Texto largo y aleatorio (ej. 40+ caracteres). Sin esto, las sesiones se pueden falsificar.
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
PORT=3000

# URL pública de la plataforma (para los enlaces de los correos).
# Opcional: si no se pone, se usa la dirección desde la que se abrió el sitio.
APP_URL=https://tu-app.onrender.com

# ── Base de datos (Turso) ─────────────────────────────────
# Si no se ponen, se usa el archivo local backend/zevorus.db (para tu compu).
TURSO_DATABASE_URL=libsql://tu-base-tu-usuario.turso.io
TURSO_AUTH_TOKEN=tu_token_de_turso

# ── Correo (Gmail con "contraseña de aplicación") ─────────
# Necesario para: confirmar cuentas, recuperar contraseña, avisos de aprobación y formulario de contacto.
# Sin esto, las cuentas nuevas se activan SIN confirmar el correo.
SMTP_USER=Yovana.zevorus@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx
CONTACT_EMAIL_TO=Yovana.zevorus@gmail.com

# ── Odoo (opcional) ───────────────────────────────────────
ODOO_URL=https://tuempresa.odoo.com
ODOO_DB=tuempresa
ODOO_USERNAME=integracion@zevorus.com
ODOO_API_KEY=tu_api_key_aqui

# ── Bot de Telegram (opcional) ────────────────────────────
# Clave compartida con bot_zevorus.py para que el bot pueda crear tickets.
# Debe ser EXACTAMENTE la misma que BOT_SECRET dentro del bot.
BOT_SECRET=pon_aqui_una_clave_larga
